# Пример локального окружения kcs-monitor.
# Скопируй в .env и подставь свои значения: cp .env.example .env
# Приложение само читает .env из текущего каталога (dotenvy) —
# существующие переменные окружения имеют приоритет.

# Биржа и таймфреймы
# Имя биржи для ключа в БД (exchange); при загрузке других бирж меняется здесь
KCS_EXCHANGE=kucoin
# KCS_API_BASE=https://api.kucoin.com
# KCS_KLINE_INTERVALS=1hour,4hour,1day,1week
# KCS_SUBS_PER_CONNECTION=100

# Ограничение списка пар (отладка): пусто = все торгуемые
# KCS_SYMBOLS=BTC-USDT,ETH-USDT

# Вывод сырых свечей построчно в stdout (0/1)
# KCS_EMIT_CANDLES=0
# Период вывода статистики, сек
# KCS_STATS_SECONDS=5

# Ресинк списка пар (сек; 0 = выключен)
# KCS_RESYNC_SECONDS=300

# REST-бэкфилл закрытых свечей при старте (0 = выключен)
# KCS_BACKFILL_BARS=0
# KCS_BACKFILL_CONCURRENCY=8

# База данных (запись свечей): основная переменная — DATABASE_URL
# (используется и docker compose, и sqlx, и самим приложением).
DATABASE_URL=postgres://cryptodb:CHANGE_ME@127.0.0.1:5433/cryptodb
